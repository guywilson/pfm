# Generated by configure. Requires GNU make.
srcdir = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
datarootdir = @datarootdir@
mandir = @mandir@

CC = @CC@
CPP = @CXX@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
CXXFLAGS = @CXXFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
PTHREAD_FLAGS = @PTHREAD_FLAGS@
INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@
MKDIR_P = @MKDIR_P@
PANDOC = @PANDOC@
VBUILD = @VBUILD@
MAJOR_VERSION = @MAJOR_VERSION@
MINOR_VERSION = @MINOR_VERSION@

SOURCE=$(srcdir)/src
BUILD=$(srcdir)/build
DEP=$(srcdir)/dep

# precompile step
PRECOMPILE = @ mkdir -p $(BUILD) $(DEP)
# postcompile step
POSTCOMPILE = @ mv -f $(DEP)/$*.Td $(DEP)/$*.d

# Match the legacy debug password override: make DEBUG_PASSWD=example.
DEBUG_PASSWD =
DEBUG_CPPFLAGS =
ifeq (@DEBUG_BUILD@,yes)
DEBUG_CPPFLAGS = '-DDEBUG_PASSWORD="$(DEBUG_PASSWD)"'
endif
DEP_FLAGS = -MT $@ -MMD -MP -MF $(DEP)/$*.Td

C_SOURCES = $(wildcard $(SOURCE)/*.c)
CPP_SOURCES = $(wildcard $(SOURCE)/*.cpp)
OBJECTS = $(patsubst $(SOURCE)/%.c,$(BUILD)/%.o,$(C_SOURCES)) \
          $(patsubst $(SOURCE)/%.cpp,$(BUILD)/%.o,$(CPP_SOURCES))
DEPS = $(patsubst $(SOURCE)/%.c, $(DEP)/%.d, $(C_SOURCES)) \
       $(patsubst $(SOURCE)/%.cpp, $(DEP)/%.d, $(CPP_SOURCES))

.PHONY: all man install uninstall version clean distclean
all: pfm
ifneq ($(strip $(PANDOC)),)
all: man
endif

pfm: $(OBJECTS)
	$(CPP) $(PTHREAD_FLAGS) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBS)

$(BUILD)/%.o: $(SOURCE)/%.c makefile
	$(PRECOMPILE)
	$(CC) $(CPPFLAGS) $(DEBUG_CPPFLAGS) $(CFLAGS) $(DEP_FLAGS) -c $< -o $@
	$(POSTCOMPILE)

$(BUILD)/%.o: $(SOURCE)/%.cpp makefile
	$(PRECOMPILE)
	$(CPP) $(CPPFLAGS) $(DEBUG_CPPFLAGS) $(CXXFLAGS) $(DEP_FLAGS) -c $< -o $@
	$(POSTCOMPILE)

-include $(DEPS)

man: pfm.1
pfm.1: $(srcdir)/doc/pfm.1.md
	@test -n "$(PANDOC)" || { echo "pandoc is required to build the manual page" >&2; exit 1; }
	$(PANDOC) -s -t man -o $@ $<

install: pfm man
	cp pfm /usr/local/bin
	cp pfm.1 /usr/local/share/man/man1

uninstall:
	rm -f /usr/local/bin/pfm /usr/local/share/man/man1/pfm.1

# Deliberately updates the source tree, including for out-of-tree builds.
version:
	@command -v "$(VBUILD)" >/dev/null 2>&1 || { echo "make version requires vbuild; set VBUILD=/path/to/vbuild" >&2; exit 1; }
	"$(VBUILD)" -i "$(srcdir)/pfm.ver" -t "$(srcdir)/version.c.template" -o "$(SOURCE)/version.c" -major $(MAJOR_VERSION) -minor $(MINOR_VERSION)

clean:
	rm -rf $(BUILD) $(DEP)
	rm -f pfm pfm.1

distclean: clean
	rm -f makefile config.log config.status
