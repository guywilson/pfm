# Generated by configure. Requires GNU make.
srcdir = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
datarootdir = @datarootdir@
mandir = @mandir@

CC = @CC@
CXX = @CXX@
CPPFLAGS = @CPPFLAGS@
CFLAGS = @CFLAGS@
CXXFLAGS = @CXXFLAGS@
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
PTHREAD_FLAGS = @PTHREAD_FLAGS@
INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL_PROGRAM@
INSTALL_DATA = @INSTALL_DATA@
MKDIR_P = @MKDIR_P@
PANDOC = @PANDOC@
VBUILD = @VBUILD@
MAJOR_VERSION = @MAJOR_VERSION@
MINOR_VERSION = @MINOR_VERSION@

# Match the legacy debug password override: make DEBUG_PASSWD=example.
DEBUG_PASSWD =
DEBUG_CPPFLAGS =
ifeq (@DEBUG_BUILD@,yes)
DEBUG_CPPFLAGS = '-DDEBUG_PASSWORD="$(DEBUG_PASSWD)"'
endif
DEP_FLAGS = -MT $@ -MMD -MP -MF $(@:.o=.Td)

C_SOURCES = $(wildcard $(srcdir)/src/*.c)
CXX_SOURCES = $(wildcard $(srcdir)/src/*.cpp)
OBJECTS = $(patsubst $(srcdir)/src/%.c,build/%.o,$(C_SOURCES)) \
          $(patsubst $(srcdir)/src/%.cpp,build/%.o,$(CXX_SOURCES))
DEPS = $(OBJECTS:.o=.d)

.PHONY: all man install uninstall version clean distclean
all: pfm
ifneq ($(strip $(PANDOC)),)
all: man
endif

pfm: $(OBJECTS)
	$(CXX) $(CXXFLAGS) $(LDFLAGS) -o $@ $(OBJECTS) $(LIBS)

# Order-only prerequisite: directory timestamps must not trigger recompilation.
build:
	$(MKDIR_P) $@

build/%.o: $(srcdir)/src/%.c makefile | build
	$(CC) $(CPPFLAGS) $(DEBUG_CPPFLAGS) $(CFLAGS) $(PTHREAD_FLAGS) $(DEP_FLAGS) -c $< -o $@
	@ mv -f $(@:.o=.Td) $(@:.o=.d)

build/%.o: $(srcdir)/src/%.cpp makefile | build
	$(CXX) $(CPPFLAGS) $(DEBUG_CPPFLAGS) $(CXXFLAGS) $(DEP_FLAGS) -c $< -o $@
	@ mv -f $(@:.o=.Td) $(@:.o=.d)

-include $(DEPS)

man: pfm.1
pfm.1: $(srcdir)/doc/pfm.1.md
	@test -n "$(PANDOC)" || { echo "pandoc is required to build the manual page" >&2; exit 1; }
	$(PANDOC) -s -t man -o $@ $<

install: pfm man
	$(MKDIR_P) "$(DESTDIR)$(bindir)" "$(DESTDIR)$(mandir)/man1"
	$(INSTALL_PROGRAM) pfm "$(DESTDIR)$(bindir)/pfm"
	$(INSTALL_DATA) pfm.1 "$(DESTDIR)$(mandir)/man1/pfm.1"

uninstall:
	rm -f "$(DESTDIR)$(bindir)/pfm" "$(DESTDIR)$(mandir)/man1/pfm.1"

# Deliberately updates the source tree, including for out-of-tree builds.
version:
	@command -v "$(VBUILD)" >/dev/null 2>&1 || { echo "make version requires vbuild; set VBUILD=/path/to/vbuild" >&2; exit 1; }
	"$(VBUILD)" -incfile "$(srcdir)/pfm.ver" -template "$(srcdir)/version.c.template" -out "$(srcdir)/src/version.c" -major $(MAJOR_VERSION) -minor $(MINOR_VERSION)

clean:
	rm -f $(OBJECTS) $(DEPS) $(OBJECTS:.o=.Td) pfm pfm.1

distclean: clean
	rm -f makefile config.log config.status
